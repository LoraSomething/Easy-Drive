<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="EasyDriveModelStoreContainer" CdmEntityContainer="EasyDriveEntities">
    <EntitySetMapping Name="Userfiles">
      <EntityTypeMapping TypeName="EasyDriveModel.Userfile">
        <MappingFragment StoreEntitySet="userfile">
          <ScalarProperty Name="storageID" ColumnName="storageID" />
          <ScalarProperty Name="extension" ColumnName="extension" />
          <ScalarProperty Name="ID" ColumnName="ID" />
          <ScalarProperty Name="filename" ColumnName="filename" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>