<UserControl x:Class="Desktop_app_easy_drive.LoginOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Desktop_app_easy_drive"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <Grid Panel.ZIndex="10">
    <Grid Panel.ZIndex="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

            <Image Grid.Row="1" Grid.Column="0" MaxHeight="200px" MaxWidth="200px" Source="C:\Users\Lora\Desktop\Easy-Drive\desktop-app-easy-drive\images\drive.png"/>
        
            <Image Grid.Row="1" Grid.Column="0" MaxHeight="200px" MaxWidth="200px" Source="C:\Users\Lora\Desktop\EasyDrive\desktop-app-easy-drive\images\drive.png"/>

            <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Welcome to Easy Drive" Margin="10" FontSize="16" Padding="5" Foreground="White" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold"/>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <Label Content="Please Log In" Margin="10" FontSize="16" Padding="5" Foreground="White" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                <Label Content="E-mail:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="10,10,10,0" Padding="5"/>
                <TextBox Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}"  Margin="10,0,10,10" Padding="5"/>
                <Label Content="Password:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="10,10,10,0" />
                <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" Margin="10,0,10,10" Padding="5" />
                <Button Content="Log In" Command="{Binding ILogin}" Margin="10,0,10,10" Padding="5" IsDefault="True"/>
                <Label Content="Don't have an account?" FontSize="14" FontWeight="Bold" Foreground="White" Margin="10,10,10,0" HorizontalContentAlignment="Center" />
                <Button Content="Create Account" Margin="10,0,10,10" Padding="5"  Width="150px"/>
            </StackPanel>
        </Grid>
        <Rectangle Fill="#EE4519"/>
    </Grid>
</UserControl>
