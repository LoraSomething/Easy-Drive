<Window x:Class="Desktop_app_easy_drive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop_app_easy_drive"
        mc:Ignorable="d"
        Title="Easy Drive" Height="600" Width="800" MinHeight="350" MinWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80px"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.8*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel  Background="#ff592e" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,0">
                <Label Content="{Binding UserEmail}" />
                <Button Content="Sign Out" Command="{Binding ILogout}"/>
            </StackPanel>
            <Label Content="Easy Drive App" Margin="5" FontSize="18" Padding="5" Foreground="White" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Selected file" Margin="0,30,0,0" Grid.ColumnSpan="3" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <Label Content="Name:" Grid.Row="1"  FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                <TextBox Text="{Binding Userfile.name }" Grid.Row="1" Grid.Column="1" Margin="15,5,15,5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Label Content="Extension:" Grid.Row="2"  FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Right"/>
                <TextBox Text="{Binding Userfile.fileExtension}"  Grid.Row="2" Grid.Column="1" Margin="15,5,15,5" IsEnabled="False" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="Save name" Command="{Binding IRename}" Grid.Row="1" Grid.Column="2" FontSize="14" Margin="10" Padding="5" />
                <Button Content="Download file" Command="{Binding IDownloadOne}" Grid.Row="2" Grid.Column="2" FontSize="14" Margin="10" Padding="5"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.3*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Download all"  Grid.Column="1" Grid.ColumnSpan="1" Grid.Row="0" FontSize="14" Margin="10" Padding="5"/>
                <Button Content="Upload file" Command="{Binding IGetFileURL}" Grid.Column="1" Grid.ColumnSpan="1" Grid.Row="1" FontSize="14" Margin="10" Padding="5"/>

            </Grid>

        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Content="Your files"  FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ListView ItemsSource="{Binding Userfiles}"  SelectedItem="{Binding Userfile}"  Grid.Row="1"  Margin="30">
            </ListView>
        </Grid>

        <local:LoginOverlay Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding LoginOverlayVisibility,FallbackValue=Hidden}" Loaded="LoginOverlay_Loaded"/>
        
    </Grid>

</Window>
