<Window x:Class="Desktop_app_easy_drive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop_app_easy_drive"
        mc:Ignorable="d"
        Title="Easy Drive" Height="650" Width="800" MinHeight="650" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80px"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel  Background="#ff592e" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,0">
                <Label Content="{Binding UserEmail}" />
                <Button Content="Sign Out" Command="{Binding ILogout}" Padding="5"/>
            </StackPanel>
            <Label Content="Easy Drive App" Margin="5" FontSize="18" Padding="5" Foreground="White" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.3*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.25*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.2*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Selected file" Margin="0,30,0,0" Grid.ColumnSpan="3" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <Label Content="Name:" Grid.Row="1"  FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                <TextBox Text="{Binding Userfile.name }" Grid.Row="1" Grid.Column="1" Margin="15,5,15,5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40px"/>
                <Label Content="Extension:" Grid.Row="2"  FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Right"/>
                <TextBox Text="{Binding Userfile.fileExtension}"  Grid.Row="2" Grid.Column="1" Margin="15,5,15,5" IsEnabled="False" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40px"/>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Save filename" Command="{Binding IRename}" FontSize="14" Margin="10" Padding="5" Width="100px"/>
                    <Button Content="Download file" Command="{Binding IDownloadOne}" FontSize="14" Margin="10" Padding="5" Width="100px"/>                    
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Delete file" Command="{Binding IDelete}" FontSize="14" Margin="10" Padding="5" Width="100px"/>
                    <Button Content="Upload file" Command="{Binding IGetFileURL}" FontSize="14" Margin="10" Padding="5" Width="100px"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.3*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Synchronize folder" Command="{Binding ISetSynchFolder}" Grid.Column="1" Grid.ColumnSpan="1" Grid.Row="1" FontSize="14" Margin="10" Padding="5"/>
                <StackPanel Orientation="Horizontal"  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center">
                    <Label Content="Selected Folder: " FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                    <Label Content="{Binding SynchFolder}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                </StackPanel>

            </Grid>

        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Label Content="Your files"  FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>
            <ListView ItemsSource="{Binding Userfiles}"  SelectedItem="{Binding Userfile}"  Grid.Row="1"  Margin="30 10 30 10">
            </ListView>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Label Content="Status:" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 10 1 10"/>
                <Label Content="{Binding Status}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1 10 10 10"/>
            </StackPanel>
        </Grid>

        <local:LoginOverlay Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding LoginOverlayVisibility,FallbackValue=Hidden}" Loaded="LoginOverlay_Loaded"/>
        
    </Grid>

</Window>
