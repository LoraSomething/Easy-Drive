<Window x:Class="Desktop_app_easy_drive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop_app_easy_drive"
        mc:Ignorable="d"
        Title="MainWindow" Height="443.595" Width="675.09">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <Button Command="{Binding DoTheThing}"  Content="text3" Grid.Row="1" Grid.ColumnSpan="2"/>
        <Button  Content="text4" Grid.Row="2" Grid.Column="1"/>

        <StackPanel Grid.Row="3">
            <TextBox Text="{Binding TestStr, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="{Binding TestStr}"/>
        </StackPanel>
    </Grid>
</Window>
